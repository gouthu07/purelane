<section class="sec" id="how-{{ section.id }}" data-scene="2" style="background-color: {{ section.settings.bg_color }};">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        <article class="glass pillar rv in" {{ block.shopify_attributes }}>
          <span class="pi">
            {%- if block.settings.svg_code != blank -%}
              {{ block.settings.svg_code }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 48 }}" alt="{{ block.settings.title | escape }}">
            {%- endif -%}
          </span>
          <h3 class="d3">{{ block.settings.title | escape }}</h3>
          <p class="body-s">{{ block.settings.text | escape }}</p>
          {%- if block.settings.button_label != blank -%}
            <a class="btn btn-ghost btn-sm" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Pillar heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pillar text description goes here."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Less scrubbing",
            "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "button_label": "Learn more",
            "button_link": "#shop",
            "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"8\" cy=\"8.5\" r=\"3.2\"/><circle cx=\"16.4\" cy=\"6.6\" r=\"2.2\"/><circle cx=\"15\" cy=\"13\" r=\"2.8\"/><circle cx=\"8.6\" cy=\"15.6\" r=\"2.1\"/><path d=\"M4 21h16\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Clean ingredients",
            "text": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "button_label": "Learn more",
            "button_link": "#ingredients",
            "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z\"/><path d=\"m9 12 2.2 2.2L15.4 10\"/></svg>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Safe around everyone",
            "text": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "button_label": "Learn more",
            "button_link": "#proof",
            "svg_code": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
