<section class="sec" id="signup-{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.text | escape }}</p>
      
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="your@email.com" aria-label="Email address" required>
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label | escape }}</button>
        {%- if form.posted_successfully? -%}
          <p class="form-success">Thanks for subscribing!</p>
        {%- elsif form.errors -%}
          <p class="form-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email Signup",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Email Signup"
    }
  ]
}
{% endschema %}
