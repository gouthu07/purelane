{{ 'section-product-grid.css' | asset_url | stylesheet_tag }}

<section class="product-grid-section color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.heading | default: 'Product grid' | escape }}">
  <div class="product-grid-section__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-grid-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="product-grid-section__subtext">{{ section.settings.subtext | escape }}</p>
    {%- endif -%}
  </div>

  <div class="product-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}
      {%- if product != blank -%}
        <a href="{{ product.url }}" class="product-card" {{ block.shopify_attributes }}>
          <div class="product-card__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 800',
                sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                alt: product.title,
                class: 'product-card__image'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder' }}
            {%- endif -%}
            {%- unless product.available -%}
              <span class="product-card__badge">Sold out</span>
            {%- endunless -%}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">{{ product.title | escape }}</h3>
            <span class="product-card__price">{{ product.price | money }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our bars"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Clean ingredients, real energy"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
