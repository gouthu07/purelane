<section class="sec" id="categories-{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat rv in" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title | escape }}" class="pimg">
            {%- else -%}
              <span class="pimg {{ block.settings.icon_class }}" role="img" aria-label="{{ block.settings.title | escape }}"></span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.text | escape }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "icon_class",
          "label": "Icon CSS Class (for background image)",
          "default": "p-kitchen"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Overrides Icon Class)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Kitchen bundle",
            "text": "Grease, dishes & more",
            "icon_class": "p-kitchen",
            "link": "#combos"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bathroom bundle",
            "text": "Deep clean & disinfect",
            "icon_class": "p-toilet",
            "link": "#combos"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Laundry bundle",
            "text": "Softer, fresher wash",
            "icon_class": "p-laundry",
            "link": "#combos"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hard water bundle",
            "text": "Melt away limescale",
            "icon_class": "p-tap",
            "link": "#combos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
