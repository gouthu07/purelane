<section class="sec" id="trust-bar-{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv in">
      {%- for block in section.blocks -%}
        <div class="trust-i" {{ block.shopify_attributes }}>
          {%- if block.settings.svg_code != blank -%}
            {{ block.settings.svg_code }}
          {%- elsif block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 48 }}" alt="{{ block.settings.title | escape }}">
          {%- endif -%}
          <span>{{ block.settings.title | newline_to_br }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "settings": [],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "textarea",
          "id": "svg_code",
          "label": "SVG Code"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Text",
          "default": "Trust item\ntext"
        }
      ]
    }
  ],
  "presets": [
