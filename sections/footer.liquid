<footer id="footer-{{ section.id }}" data-scene="4" class="{{ section.settings.custom_class }}">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
              <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
              <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
              <path d="M12 21v-6"/>
            </svg>
          </span>
          <span class="txt">
            <span class="n1">{{ shop.name }}</span>
            <span class="n2">{{ section.settings.slogan | escape }}</span>
          </span>
        </a>
        <p style="max-width:30ch">{{ section.settings.about_text | escape }}</p>
      </div>
      
      {%- for block in section.blocks -%}
        <div class="fcol" {{ block.shopify_attributes }}>
          <h5>{{ block.settings.title | escape }}</h5>
          {%- if block.type == 'link_list' -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endfor -%}
          {%- elsif block.type == 'text' -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
      
    </div>
    <div class="fbot">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}" style="color:inherit;text-decoration:none">{{ link.title }}</a>{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{%- if section.settings.show_sticky_cta -%}
<div class="sticky">
  <span class="lbl"><b>{{ section.settings.sticky_heading | escape }}</b><span>{{ section.settings.sticky_subtext | escape }}</span></span>
  <a class="btn btn-primary btn-sm" href="{{ section.settings.sticky_url }}">{{ section.settings.sticky_button_label | escape }}</a>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "slogan",
      "label": "Brand Slogan",
      "default": "Clean, simply"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal Menu (Bottom right)"
    },
    {
      "type": "header",
      "content": "Sticky CTA"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_cta",
      "label": "Show Sticky CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_heading",
      "label": "Sticky Heading",
      "default": "Pick any 3, pay ₹499"
    },
    {
      "type": "text",
      "id": "sticky_subtext",
      "label": "Sticky Subtext",
      "default": "Free shipping, always"
    },
    {
      "type": "text",
      "id": "sticky_button_label",
      "label": "Sticky Button Label",
      "default": "Build bundle"
    },
    {
      "type": "url",
      "id": "sticky_url",
      "label": "Sticky Button URL"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Get in touch"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content"
        }
      ]
    }
  ]
}
{% endschema %}
