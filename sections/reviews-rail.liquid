<section class="sec revband" id="reviews-{{ section.id }}" data-scene="1">
  <div class="wrap">
    <div class="revhead rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> {{ section.settings.rating_text }}</span>
      <span class="agg">{{ section.settings.loved_by_text }}</span>
    </div>
  </div>
  <div class="revrail rv in" aria-label="Customer reviews">
    <div class="revtrack" style="animation-duration: {{ section.settings.duration }}s;">
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">
            {%- for i in (1..block.settings.stars) -%}&#9733;{%- endfor -%}
          </div>
          <h5>{{ block.settings.title | escape }}</h5>
          <p>{{ block.settings.body | escape }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author | escape }}</b>
            <span>&middot; {{ block.settings.product_tag | escape }}</span>
          </div>
        </article>
      {%- endfor -%}
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">
            {%- for i in (1..block.settings.stars) -%}&#9733;{%- endfor -%}
          </div>
          <h5>{{ block.settings.title | escape }}</h5>
          <p>{{ block.settings.body | escape }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author | escape }}</b>
            <span>&middot; {{ block.settings.product_tag | escape }}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "textarea",
      "id": "rating_text",
      "label": "Rating Text (HTML allowed)",
      "default": "<b>4.8</b> from 8,000+ reviews"
    },
    {
      "type": "textarea",
      "id": "loved_by_text",
      "label": "Loved by Text (HTML allowed)",
      "default": "Loved by <b>12 lakh+</b> homes"
    },
    {
      "type": "range",
      "id": "duration",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "s",
      "label": "Animation Duration",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Rail",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "author": "Anita",
            "product_tag": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_tag": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "author": "Sunita",
            "product_tag": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "author": "Rohit S.",
            "product_tag": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "author": "Verified buyer",
            "product_tag": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
