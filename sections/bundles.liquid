        },
        {
          "type": "text",
          "id": "img_class_2",
          "label": "Image 2 CSS class"
        },
        {
          "type": "text",
          "id": "img_class_3",
          "label": "Image 3 CSS class"
        },
        {
          "type": "text",
          "id": "img_class_4",
          "label": "Image 4 CSS class"
        },
        {
          "type": "text",
          "id": "img_class_5",
          "label": "Image 5 CSS class"
        },
        {
          "type": "header",
          "content": "Features"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "product_count": 2,
            "bundle_price": 349,
            "original_price": 598,
            "img_class_1": "p-combo2",
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "is_best": true,
            "product_count": 3,
            "bundle_price": 499,
            "original_price": 897,
