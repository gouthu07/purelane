<section class="sec" id="bundles-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv in" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.subtext | escape }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv in" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag | escape }}</span>
          
          <div class="tierpix {% if block.settings.img_class_4 != blank or block.settings.img_class_5 != blank %}five{% endif %}" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- capture img_setting -%}img_class_{{ i }}{%- endcapture -%}
              {%- assign img_class = block.settings[img_setting] -%}
              {%- if img_class != blank -%}
                <span class="pimg {{ img_class }}" role="img"></span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          
          <div class="qty">{{ block.settings.product_count }}<small>Products</small></div>
          
          {%- assign bundle_price = block.settings.bundle_price | times: 100 -%}
          {%- assign original_price = block.settings.original_price | times: 100 -%}
          <div class="price">
            {{ bundle_price | money_without_trailing_zeros }} <s>{{ original_price | money_without_trailing_zeros }}</s>
          </div>
          
          {%- assign per_product = bundle_price | divided_by: block.settings.product_count -%}
          <p class="body-s" style="font-size:12px">Flat {{ per_product | money_without_trailing_zeros }} per product</p>
          
          <ul>
            {%- for i in (1..4) -%}
              {%- capture feature_setting -%}feature_{{ i }}{%- endcapture -%}
              {%- assign feature = block.settings[feature_setting] -%}
              {%- if feature != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ feature | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          
          <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#shop' }}">
            {{ block.settings.button_label | escape }}
            {%- if block.settings.is_best -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
