<section class="sec" id="combos-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv in">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.subtext | escape }}</p>
    </div>
    
    <div class="comborail rv in">
      {%- for block in section.blocks -%}
        <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {%- if block.settings.save_badge_text != blank -%}
              <span class="save">{{ block.settings.save_badge_text | escape }}</span>
            {%- endif -%}
            {%- if block.settings.flag_text != blank -%}
              <span class="flag">{{ block.settings.flag_text | escape }}</span>
            {%- endif -%}
            
            <div class="stack">
              {%- for i in (1..5) -%}
                {%- capture product_setting -%}product_{{ i }}{%- endcapture -%}
                {%- capture img_class_setting -%}img_class_{{ i }}{%- endcapture -%}
                {%- capture reason_setting -%}reason_{{ i }}{%- endcapture -%}
                
                {%- assign prod = block.settings[product_setting] -%}
                {%- assign img_class = block.settings[img_class_setting] -%}
                {%- assign reason = block.settings[reason_setting] -%}
                
                {%- if prod != blank or img_class != blank -%}
                  <span class="it">
                    {%- if img_class contains 'tile' -%}
                      <span class="tile">
                        {{ img_class | replace: 'tile:', '' }}
                      </span>
                    {%- elsif prod != blank and prod.featured_image != blank and img_class == blank -%}
                      <span class="pimg" style="background-image: url('{{ prod.featured_image | image_url: width: 200 }}')"></span>
                    {%- else -%}
                      <span class="pimg {{ img_class }}" role="img" aria-label="{% if prod != blank %}{{ prod.title | escape }}{% endif %}"></span>
                    {%- endif -%}
                    <span>{{ reason | escape }}</span>
                  </span>
                  {%- unless forloop.last -%}
                    {%- capture next_prod_setting -%}product_{{ i | plus: 1 }}{%- endcapture -%}
                    {%- capture next_img_setting -%}img_class_{{ i | plus: 1 }}{%- endcapture -%}
                    {%- if block.settings[next_prod_setting] != blank or block.settings[next_img_setting] != blank -%}
                      <span class="plus" aria-hidden="true">+</span>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          
          <div class="body">
            <h3>{{ block.settings.title | escape }}</h3>
            <div class="cnt">{{ block.settings.product_count }} products</div>
            <p class="inc">{{ block.settings.includes_text | escape }}</p>
            
            {%- assign bundle_price = block.settings.bundle_price | times: 100 -%}
            {%- assign original_price = block.settings.original_price | times: 100 -%}
            {%- assign savings = original_price | minus: bundle_price -%}
            
            <div class="prow">
              <strong>{{ bundle_price | money_without_trailing_zeros }}</strong>
              <s>{{ original_price | money_without_trailing_zeros }}</s>
              <em>Save {{ savings | money_without_trailing_zeros }}</em>
            </div>
            
            <div class="fine">Inclusive of all taxes &middot; COD available</div>
            <a class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
              {{ block.settings.button_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      {{ section.settings.swipe_text | escape }}
    </div>
    <p class="railnote">{{ section.settings.rail_note | escape }}</p>
  </div>
</section>

